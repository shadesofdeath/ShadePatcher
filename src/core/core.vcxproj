    </ClCompile>
    <ClCompile Include="mods\taskbar_start_button_position.cpp">
      <ExceptionHandling>Sync</ExceptionHandling>
    </ClCompile>
    <ClCompile Include="mods\taskbar_empty_space_clicks.cpp" />
    <ClCompile Include="mods\taskbar_volume_control.cpp" />
