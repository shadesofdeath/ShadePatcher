<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    core: ShadePatcher.dll, the module explorer.exe loads.
    Holds the mod engine (src/core/engine) and the mods themselves (src/core/mods).
  -->
  <Import Project="..\..\build\props\shared.props" />
  <PropertyGroup Label="Globals">
    <ProjectGuid>{C3F5E4D6-7F80-4192-ACBD-2E3F4A5B6C7D}</ProjectGuid>
    <RootNamespace>core</RootNamespace>
    <ProjectName>core</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <Import Project="..\..\build\props\configuration.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="..\..\build\props\targets.props" />
  <PropertyGroup>
    <TargetName>ShadePatcher</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- $(MSBuildThisFileDirectory) is what lets a mod include "engine/modapi.h" -->
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);$(SolutionDir)libs\SlimDetours\include;$(SolutionDir)vendor\winui3;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <!-- runtimeobject.lib provides the WinRT activation entry points C++/WinRT calls; see mods\taskbar_menu_entry.cpp. -->
      <AdditionalDependencies>ntdll.lib;runtimeobject.lib;$(SolutionDir)libs\SlimDetours\lib\x64\$(Configuration)\KNSoft.SlimDetours.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup Label="Entry points and the injection vector">
    <ClCompile Include="dllmain.c" />
    <ClCompile Include="dxgi_proxy.c" />
  </ItemGroup>
  <ItemGroup Label="Engine">
    <ClInclude Include="engine\hooks.h" />
    <ClInclude Include="engine\input.h" />
    <ClInclude Include="engine\log.h" />
    <ClInclude Include="engine\manager.h" />
    <ClInclude Include="engine\mod.h" />
    <ClInclude Include="engine\modapi.h" />
    <ClInclude Include="engine\settings.h" />
    <ClInclude Include="engine\safemode.h" />
    <ClInclude Include="engine\symbols.h" />
    <ClInclude Include="engine\modules.h" />
    <ClCompile Include="engine\hooks.c" />
    <ClCompile Include="engine\hostinject.c" />
    <ClCompile Include="engine\input.c" />
