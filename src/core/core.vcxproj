    <ClCompile Include="engine\surfaces.c" />
    <ClCompile Include="engine\symbols.cpp" />
    <ClCompile Include="engine\update.c" />
  </ItemGroup>
  <ItemGroup Label="Mods">
    <ClCompile Include="mods\mod_table.c" />
    <ClCompile Include="mods\tray_show_all_icons.cpp" />
    <ClCompile Include="mods\tray_icons_rebroadcast.cpp" />
    <ClCompile Include="mods\desktop_toggle_icons.cpp" />
    <ClCompile Include="mods\context_menu_preloader.cpp" />
    <ClCompile Include="mods\explorer_auto_file_sizes.cpp" />
    <ClCompile Include="mods\explorer_double_click_up.cpp" />
    <ClCompile Include="mods\shell_menu_entry.cpp" />
    <ClCompile Include="mods\desktop_icons_view.cpp" />
    <ClCompile Include="mods\extension_change_no_warning.cpp" />
    <ClCompile Include="mods\taskbar_button_click.cpp" />
