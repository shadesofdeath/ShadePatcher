    </ClCompile>
    <ClCompile Include="mods\taskbar_labels.cpp">
      <ExceptionHandling>Sync</ExceptionHandling>
    </ClCompile>
    <!-- C++/WinRT reports failures by throwing, so this one mod is compiled with exceptions on. Everything
         XAML can call into is wrapped; see the file's header comment. -->
    <ClCompile Include="mods\taskbar_menu_entry.cpp">
      <ExceptionHandling>Sync</ExceptionHandling>
    </ClCompile>
    <!-- Same reason: it talks to WinUI 3 through C++/WinRT. -->
    <ClCompile Include="mods\desktop_menu_entry.cpp">
      <ExceptionHandling>Sync</ExceptionHandling>
    </ClCompile>
    <ClCompile Include="mods\custom_start_menu.cpp" />
  </ItemGroup>
  <ItemGroup Label="Start menu (the custom-start-menu mod)">
