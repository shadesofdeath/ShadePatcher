// core.rc - version info and product icon of ShadePatcher.dll.
#include "winres.h"
#include "version.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

/////////////////////////////////////////////////////////////////////////////
// Icon
//
// Id 1, the lowest-numbered icon resource, which is the one Explorer shows for the file. The same artwork the
// settings window uses.

1                       ICON                    "..\\common\\app.ico"

/////////////////////////////////////////////////////////////////////////////
// Fonts of the Start menu (custom-start-menu mod): Figtree, SIL Open Font License, startmenu\fonts\OFL.txt.
// Loaded from here by startmenu\text.cpp; nothing is installed on the system.

#include "startmenu\\fontres.h"

IDR_FONT_FIGTREE_REGULAR    RCDATA                  "startmenu\\fonts\\Figtree-Regular.ttf"
IDR_FONT_FIGTREE_MEDIUM     RCDATA                  "startmenu\\fonts\\Figtree-Medium.ttf"
IDR_FONT_FIGTREE_SEMIBOLD   RCDATA                  "startmenu\\fonts\\Figtree-SemiBold.ttf"
IDR_FONT_FIGTREE_BOLD       RCDATA                  "startmenu\\fonts\\Figtree-Bold.ttf"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_FILE
 PRODUCTVERSION VER_PRODUCT
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "shadesofdeath"
            VALUE "FileDescription", "ShadePatcher"
            VER_FILE_STRING
            VALUE "InternalName", "ShadePatcher.dll"
            VALUE "LegalCopyright", "Copyright (C) 2026 shadesofdeath"
            VALUE "OriginalFilename", "ShadePatcher.dll"
            VALUE "ProductName", "ShadePatcher"
            VER_PRODUCT_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
