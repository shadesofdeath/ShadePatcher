BEGIN
    IDS_PRODUCTNAME                 "ShadePatcher"

    IDS_LANG_FOLLOW_SYSTEM          "Follow system setting (default)"
    IDS_EXPORT_SUCCESS              "Settings have been exported successfully."
    IDS_IMPORT_FAILED               "The settings file could not be imported."
    IDS_SECONDS_3                   "3 seconds"
    IDS_SECONDS_5                   "5 seconds"
    IDS_SECONDS_10                  "10 seconds"
    IDS_SECONDS_20                  "20 seconds"
    IDS_SECONDS_30                  "30 seconds"

    IDS_PAGE_GENERAL                "General"
    IDS_GENERAL_DESCRIPTION         "Options marked with (*) need a File Explorer restart."
    IDS_GENERAL_HEADING_WELCOME     "Welcome to ShadePatcher"
    IDS_GENERAL_INTRO_1             "ShadePatcher improves the Windows shell (explorer.exe) with small mods you pick one by one."
    IDS_GENERAL_INTRO_2             "Every mod touching the taskbar, the desktop or File Explorer runs in our own engine."
    IDS_GENERAL_INTRO_3             "Settings apply immediately; most changes need no restart."
    IDS_GENERAL_HEADING_HOWTO       "How to use it"
    IDS_GENERAL_STEP_1              "1. Turn on the improvements you want on the Mods page."
    IDS_GENERAL_STEP_2              "2. Put your own shortcuts in the right-click menus from the menu pages."
    IDS_GENERAL_STEP_3              "3. If anything goes wrong, restore the defaults from the Settings page."
    IDS_GENERAL_HEADING_STATUS      "Status"
    IDS_GENERAL_ENGINE_INSTALLED    "Engine: ACTIVE, running inside explorer.exe (installed)."
    IDS_GENERAL_ENGINE_INJECTED     "Engine: ACTIVE, running inside explorer.exe (not installed, loaded by hand)."
    IDS_GENERAL_ENGINE_MISSING      "Engine: NOT LOADED. explorer.exe has no engine in it; run the installer or restart File Explorer below."
    IDS_GENERAL_ENGINE_SAFEMODE     "Engine: SAFE MODE. The shell started several times in a row, so no mod was loaded this session. Turn the offending mod off and restart File Explorer."
    IDS_GENERAL_ENGINE_RESTARTING   "Engine: File Explorer is being restarted, please wait..."
    IDS_GENERAL_START_AT_LOGON      "Load the engine into File Explorer at sign-in"
    IDS_GENERAL_START_AT_LOGON_NOTE "Not needed when installed; without an install this brings the engine back on every sign-in."
    IDS_GENERAL_LINK                "Project page"

